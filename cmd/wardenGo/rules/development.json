[
    {
        "id": "rule-dev-001",
        "name": "Source Code Modification Outside Business Hours",
        "conditions": {
            "file_path": "src",
            "action": "write"
        },
        "severity": "low",
        "action": "alert"
    },
    {
        "id": "rule-dev-002",
        "name": "Git Configuration Modification",
        "conditions": {
            "file_path": ".git/config",
            "action": "write"
        },
        "severity": "medium",
        "action": "alert"
    },
    {
        "id": "rule-dev-003",
        "name": "Package Lock File Modification",
        "conditions": {
            "file_path": "package-lock.json",
            "action": "write"
        },
        "severity": "low",
        "action": "alert"
    },
    {
        "id": "rule-dev-004",
